{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "moduleResolution": "node",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "outDir": "dist",
      "types": ["node"],
      "baseUrl": ".",
      "paths": {
        "@controllers/*": ["controllers/*"]
      }
    },
    "include": ["**/*.ts", "**/*.d.ts"],
    "exclude": ["node_modules", "dist"]
  }